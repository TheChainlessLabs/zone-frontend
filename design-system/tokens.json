{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Omega Markets Design System",
  "version": "2.0.0",
  "description": "Design tokens for the Omega Markets decentralized darkpool FX trading platform",

  "color": {
    "accent": {
      "default": "#D4A847",
      "hover": "#E0B557",
      "active": "#B88E2E",
      "muted": "#6B5826",
      "subtle": "#D4A8471F"
    },
    "text": {
      "primary": "#F2EBDD",
      "secondary": "#B0A89E",
      "muted": "#6E6862",
      "inverse": "#0E0D0B"
    },
    "background": {
      "base": "#0E0D0B",
      "surface": "#181614",
      "elevated": "#221F1C",
      "overlay": "#2D2A26"
    },
    "border": {
      "default": "#3A3633",
      "subtle": "#2A2724",
      "focus": "#D4A847",
      "focusRing": "#D4A84726"
    },
    "semantic": {
      "success": {
        "default": "#6FA07F",
        "hover": "#7CB28E",
        "active": "#5C8B6C",
        "subtle": "#6FA07F1F"
      },
      "error": {
        "default": "#C97266",
        "hover": "#D4847A",
        "active": "#B25F54",
        "subtle": "#C972661F"
      },
      "warning": {
        "default": "#C97B3A",
        "hover": "#D88B4A",
        "active": "#B26830",
        "subtle": "#C97B3A1F"
      },
      "info": {
        "default": "#B0A89E",
        "hover": "#C0B8AE",
        "active": "#98908A",
        "subtle": "#B0A89E1F",
        "_note": "Aliased to warm secondary; was cyan #0EA5E9. Component migration to text-secondary tracked separately."
      }
    }
  },

  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "display": {
        "fontSize": "64px",
        "lineHeight": "70px",
        "letterSpacing": "-0.04em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h1": {
        "fontSize": "32px",
        "lineHeight": "38px",
        "letterSpacing": "-0.02em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h2": {
        "fontSize": "24px",
        "lineHeight": "30px",
        "letterSpacing": "-0.02em",
        "fontWeight": 600,
        "fontFamily": "display"
      },
      "h3": {
        "fontSize": "18px",
        "lineHeight": "22px",
        "letterSpacing": "0",
        "fontWeight": 500,
        "fontFamily": "display"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "bodySmall": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "label": {
        "fontSize": "11px",
        "lineHeight": "14px",
        "letterSpacing": "0.08em",
        "fontWeight": 500,
        "fontFamily": "display",
        "textTransform": "uppercase"
      },
      "monoLarge": {
        "fontSize": "28px",
        "lineHeight": "34px",
        "letterSpacing": "0",
        "fontWeight": 600,
        "fontFamily": "mono"
      },
      "monoBody": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "mono"
      }
    }
  },

  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    }
  },

  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.5)",
    "focusRing": "0 0 0 3px #D4A84726"
  },

  "component": {
    "height": {
      "sm": "32px",
      "md": "40px",
      "lg": "48px"
    },
    "button": {
      "height": "44px",
      "paddingInline": "24px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 600,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "input": {
      "height": "44px",
      "paddingInline": "16px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 400
    },
    "badge": {
      "height": "22px",
      "paddingInline": "8px",
      "radius": "4px",
      "fontSize": "11px",
      "fontWeight": 500,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  },

  "transition": {
    "fast": "100ms",
    "normal": "150ms",
    "slow": "300ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
