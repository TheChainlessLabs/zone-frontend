# 1inch Spot Price API key (get from https://portal.1inch.dev)
# ONEINCH_API_KEY=your_api_key_here

# Tempo Wallet is the private-alpha default. Generic EVM wallets are disabled
# until Tempo fee estimation and signing support lands broadly.

# Feature flag: show the Explorer entry in Navbar and MobileTabBar.
# Unset or any value other than "true" hides the Explorer link (demo default).
# NEXT_PUBLIC_EXPLORER_ENABLED=true

# Chart seed demo — when "true", useMidpointHistory synthesises a back-
# history spanning the 1D window (288 points, 5-min cadence, ±0.3 %
# random walk) on fresh tabs with an empty sessionStorage buffer so
# demos / screenshots land on a populated chart. Real midpoint ticks
# still append over time. Ignored outside NODE_ENV=development, so a
# misconfigured prod build cannot ship synthetic prices to real users.
# NEXT_PUBLIC_CHART_SEED_DEMO=true
