---
import { ArrowRight } from "lucide-astro";
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
  <!-- Background grid pattern -->
  <div
    class="absolute inset-0"
    style="background-image: linear-gradient(var(--color-bg-surface) 1px, transparent 1px), linear-gradient(90deg, var(--color-bg-surface) 1px, transparent 1px); background-size: 64px 64px; opacity: 0.3;"
  >
  </div>
  <!-- Radial glow -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse 60% 50% at 50% 40%, var(--color-accent-subtle), transparent);"
  >
  </div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <p class="text-label-uppercase text-accent mb-6">Built on Zero Knowledge</p>
    <h1
      class="text-h1 lg:text-display tracking-[-0.04em] font-bold mb-6"
    >
      Provable FX.<br />Instant Settlement.
    </h1>
    <p class="text-body text-text-secondary max-w-xl mx-auto mb-10">
      The first orderbook exchange with zero-knowledge proven fills, TEE-secured matching, and cross-chain settlement.
    </p>
    <a
      href="/trade"
      class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover active:bg-accent-active text-text-inverse px-6 h-[44px] rounded-md text-body-sm font-semibold tracking-[0.08em] uppercase transition-fast"
    >
      Launch App
      <ArrowRight size={16} />
    </a>
  </div>
</section>
