---
const nodes = [
  { label: "User", sub: "Encrypted order" },
  { label: "API", sub: "Gateway" },
  { label: "TEE Matcher", sub: "Secure enclave" },
  { label: "Prover", sub: "ZK circuit" },
  { label: "Chain", sub: "Settlement" },
];
---

<section class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-label-uppercase text-accent mb-4">Architecture</p>
    <h2 class="text-h2 font-semibold mb-12">End-to-end provable pipeline</h2>

    <!-- Desktop: horizontal flow -->
    <div class="hidden md:flex items-center justify-between gap-2">
      {nodes.map((node, i) => (
        <>
          <div class="flex-1 bg-bg-surface border border-border rounded-md p-4 text-center">
            <p class="text-body-sm font-medium">{node.label}</p>
            <p class="text-label text-text-muted mt-1">{node.sub}</p>
          </div>
          {i < nodes.length - 1 && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-accent">
              <path d="M5 12h14m0 0l-4-4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </>
      ))}
    </div>

    <!-- Mobile: vertical flow -->
    <div class="flex md:hidden flex-col items-center gap-2">
      {nodes.map((node, i) => (
        <>
          <div class="w-full bg-bg-surface border border-border rounded-md p-4 text-center">
            <p class="text-body-sm font-medium">{node.label}</p>
            <p class="text-label text-text-muted mt-1">{node.sub}</p>
          </div>
          {i < nodes.length - 1 && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-accent">
              <path d="M12 5v14m0 0l-4-4m4 4l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </>
      ))}
    </div>
  </div>
</section>
