{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Omega Markets Design System",
  "version": "2.0.0",
  "description": "Design tokens for the Omega Markets decentralized darkpool FX trading platform",

  "color": {
    "accent": {
      "default": "#0EA5E9",
      "hover": "#38BDF8",
      "active": "#0284C7",
      "muted": "#7DD3FC",
      "subtle": "#0EA5E91F"
    },
    "text": {
      "primary": "#FAFAFA",
      "secondary": "#B5B5B5",
      "muted": "#707070",
      "inverse": "#0A0A0A"
    },
    "background": {
      "base": "#0A0A0A",
      "surface": "#161616",
      "elevated": "#232323",
      "overlay": "#2E2E2E"
    },
    "border": {
      "default": "#333333",
      "subtle": "#1F1F1F",
      "focus": "#38BDF8",
      "focusRing": "#38BDF826"
    },
    "semantic": {
      "success": {
        "default": "#22C55E",
        "hover": "#2DD96B",
        "active": "#1EA750",
        "subtle": "#22C55E1F"
      },
      "error": {
        "default": "#EF4444",
        "hover": "#F25D5D",
        "active": "#D93B3B",
        "subtle": "#EF44441F"
      },
      "warning": {
        "default": "#F59E0B",
        "hover": "#F7AE2E",
        "active": "#D98B09",
        "subtle": "#F59E0B1F"
      },
      "info": {
        "default": "#0EA5E9",
        "hover": "#38BDF8",
        "active": "#0284C7",
        "subtle": "#0EA5E91F"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "display": {
        "fontSize": "64px",
        "lineHeight": "70px",
        "letterSpacing": "-0.04em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h1": {
        "fontSize": "32px",
        "lineHeight": "38px",
        "letterSpacing": "-0.02em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h2": {
        "fontSize": "24px",
        "lineHeight": "30px",
        "letterSpacing": "-0.02em",
        "fontWeight": 600,
        "fontFamily": "display"
      },
      "h3": {
        "fontSize": "18px",
        "lineHeight": "22px",
        "letterSpacing": "0",
        "fontWeight": 500,
        "fontFamily": "display"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "bodySmall": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "label": {
        "fontSize": "11px",
        "lineHeight": "14px",
        "letterSpacing": "0.08em",
        "fontWeight": 500,
        "fontFamily": "display",
        "textTransform": "uppercase"
      },
      "monoLarge": {
        "fontSize": "28px",
        "lineHeight": "34px",
        "letterSpacing": "0",
        "fontWeight": 600,
        "fontFamily": "mono"
      },
      "monoBody": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "mono"
      }
    }
  },

  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    }
  },

  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.5)",
    "focusRing": "0 0 0 3px #38BDF826"
  },

  "component": {
    "height": {
      "sm": "32px",
      "md": "40px",
      "lg": "48px"
    },
    "button": {
      "height": "44px",
      "paddingInline": "24px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 600,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "input": {
      "height": "44px",
      "paddingInline": "16px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 400
    },
    "badge": {
      "height": "22px",
      "paddingInline": "8px",
      "radius": "4px",
      "fontSize": "11px",
      "fontWeight": 500,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  },

  "transition": {
    "fast": "100ms",
    "normal": "150ms",
    "slow": "300ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
