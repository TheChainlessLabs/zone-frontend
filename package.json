{
  "name": "omega-interface",
  "private": true,
  "description": "Frontend for the Omega Markets protocol — darkpool FX trading with zero-knowledge proofs",
  "repository": {
    "type": "git",
    "url": "https://github.com/omega-markets/omega-interface"
  },
  "license": "BUSL-1.1",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @omega/app dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @omega/app exec tsc --noEmit",
    "test": "pnpm --filter @omega/app test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
