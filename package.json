{
  "name": "omega-interface",
  "private": true,
  "description": "Frontend for the Omega Markets protocol — darkpool FX trading with zero-knowledge proofs",
  "repository": {
    "type": "git",
    "url": "https://github.com/omega-markets/omega-interface"
  },
  "license": "BUSL-1.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev:app": "pnpm --filter app dev",
    "dev:landing": "pnpm --filter landing dev",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "pnpm --filter @omega/app exec tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
