---
import { Send, ShieldCheck, CheckCircle } from "lucide-astro";

const steps = [
  {
    icon: Send,
    step: "01",
    title: "Submit Order",
    description: "Place encrypted limit or market orders through our API. Your intent stays private until matched.",
  },
  {
    icon: ShieldCheck,
    step: "02",
    title: "TEE Matching",
    description: "Orders are matched inside a Trusted Execution Environment. No front-running, no information leakage.",
  },
  {
    icon: CheckCircle,
    step: "03",
    title: "Proven Settlement",
    description: "Every fill generates a zero-knowledge proof, verifiable on-chain. Trustless, final, instant.",
  },
];
---

<section class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-label-uppercase text-accent mb-4">How It Works</p>
    <h2 class="text-h2 font-semibold mb-12">Three steps to provable execution</h2>

    <div class="flex flex-col md:flex-row gap-6">
      {steps.map(({ icon: Icon, step, title, description }) => (
        <div class="flex-1 bg-bg-surface border border-border rounded-lg p-6">
          <div class="flex items-center gap-3 mb-4">
            <Icon size={32} class="text-accent shrink-0" />
            <span class="text-label-uppercase text-info bg-info-subtle px-2 py-0.5 rounded-sm">
              Step {step}
            </span>
          </div>
          <h3 class="text-h3 font-medium mb-2">{title}</h3>
          <p class="text-body-sm text-text-secondary">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
