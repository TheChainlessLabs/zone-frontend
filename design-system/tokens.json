{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Omega Markets Design System",
  "version": "2.0.0",
  "description": "Design tokens for the Omega Markets decentralized darkpool FX trading platform",

  "color": {
    "accent": {
      "default": "#3A6EA5",
      "hover": "#4A7FB8",
      "active": "#2E5984",
      "muted": "#6B92BD",
      "subtle": "#3A6EA51F",
      "_note": "Calm steel blue. Used as the default accent everywhere — buy/sell toggle, primary CTA when not buy/sell-tinted, active tabs, focus rings on non-precision inputs."
    },
    "accentStrong": {
      "default": "#22D3EE",
      "hover": "#38DDF6",
      "active": "#1AB8D1",
      "subtle": "#22D3EE1F",
      "_note": "Cyan. RESERVED for Limit-mode precision surfaces only: price-input focus ring, active LIMIT tab underline, at most one precision label. Never on the CTA, never on the form border, never on the chart line. Reject in review if it appears anywhere else."
    },
    "text": {
      "primary": "#F5F5F5",
      "secondary": "#A1A1A1",
      "muted": "#6B6B6B",
      "inverse": "#0A0A0A"
    },
    "background": {
      "base": "#0A0A0A",
      "surface": "#141414",
      "elevated": "#1C1C1C",
      "overlay": "#181818"
    },
    "border": {
      "default": "rgba(255, 255, 255, 0.14)",
      "subtle": "rgba(255, 255, 255, 0.08)",
      "focus": "#22D3EE",
      "focusRing": "rgba(34, 211, 238, 0.20)"
    },
    "semantic": {
      "success": {
        "default": "#4D8C57",
        "hover": "#5A9D65",
        "active": "#3F7448",
        "subtle": "#4D8C571F"
      },
      "error": {
        "default": "#A85A5A",
        "hover": "#B86A6A",
        "active": "#8E4848",
        "subtle": "#A85A5A1F"
      },
      "warning": {
        "default": "#B88746",
        "hover": "#C99757",
        "active": "#9A7038",
        "subtle": "#B887461F"
      },
      "info": {
        "default": "#3A6EA5",
        "hover": "#4A7FB8",
        "active": "#2E5984",
        "subtle": "#3A6EA51F"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "display": {
        "fontSize": "64px",
        "lineHeight": "70px",
        "letterSpacing": "-0.04em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h1": {
        "fontSize": "32px",
        "lineHeight": "38px",
        "letterSpacing": "-0.02em",
        "fontWeight": 700,
        "fontFamily": "display"
      },
      "h2": {
        "fontSize": "24px",
        "lineHeight": "30px",
        "letterSpacing": "-0.02em",
        "fontWeight": 600,
        "fontFamily": "display"
      },
      "h3": {
        "fontSize": "18px",
        "lineHeight": "22px",
        "letterSpacing": "0",
        "fontWeight": 500,
        "fontFamily": "display"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "bodySmall": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "display"
      },
      "label": {
        "fontSize": "11px",
        "lineHeight": "14px",
        "letterSpacing": "0.08em",
        "fontWeight": 500,
        "fontFamily": "display",
        "textTransform": "uppercase"
      },
      "monoLarge": {
        "fontSize": "28px",
        "lineHeight": "34px",
        "letterSpacing": "0",
        "fontWeight": 600,
        "fontFamily": "mono"
      },
      "monoBody": {
        "fontSize": "14px",
        "lineHeight": "21px",
        "letterSpacing": "0",
        "fontWeight": 400,
        "fontFamily": "mono"
      }
    }
  },

  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    }
  },

  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.5)",
    "focusRing": "0 0 0 3px rgba(34, 211, 238, 0.20)"
  },

  "component": {
    "height": {
      "sm": "32px",
      "md": "40px",
      "lg": "48px"
    },
    "button": {
      "height": "44px",
      "paddingInline": "24px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 600,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "input": {
      "height": "44px",
      "paddingInline": "16px",
      "radius": "8px",
      "fontSize": "14px",
      "fontWeight": 400
    },
    "badge": {
      "height": "22px",
      "paddingInline": "8px",
      "radius": "4px",
      "fontSize": "11px",
      "fontWeight": 500,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  },

  "transition": {
    "fast": "100ms",
    "normal": "150ms",
    "slow": "300ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
