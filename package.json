{
  "name": "omega-interface",
  "private": true,
  "description": "Frontend for the Omega Markets protocol — darkpool FX trading with zero-knowledge proofs",
  "repository": {
    "type": "git",
    "url": "https://github.com/omega-markets/omega-interface"
  },
  "license": "BUSL-1.1",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "dev": "pnpm sync-tokens && pnpm --filter @omega/app dev",
    "build": "pnpm --filter @omega/app build",
    "typecheck": "pnpm --filter @omega/app exec tsc --noEmit",
    "test": "pnpm --filter @omega/app test",
    "prepare": "node scripts/configure-git-hooks.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "accounts": ">=0.10 <0.13"
      }
    }
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9"
  }
}
